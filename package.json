{
  "name": "supatripwire",
  "version": "0.0.0",
  "description": "Detect cross-tenant reads in a Supabase project from its API gateway logs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supatripwire": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "supabase",
    "postgrest",
    "rls",
    "multi-tenant",
    "security",
    "monitoring",
    "logs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/supatripwire.git"
  },
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/supatripwire/issues"
  },
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:lib && pnpm check:package",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.9",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@piro0919/biome-config": "github:piro0919/biome-config#v1.1.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "lefthook": "^2.2.3",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  }
}
